---
import Layout from '../../layouts/Layout.astro';
import { communes, type Commune } from '../../data/communes';

export function getStaticPaths() {
  return communes.map(commune => ({
    params: { commune: commune.slug },
    props: { commune },
  }));
}

interface Props {
  commune: Commune;
}

const { commune } = Astro.props;
---

<Layout title={`Plombier Chauffagiste à ${commune.name} (${commune.postalCode}) | Urgence 24/7`} description={`Votre artisan plombier chauffagiste intervient rapidement à ${commune.name} (${commune.postalCode}) et ses quartiers. Dépannage, débouchage et installation sanitaire.`}>
  
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0">
      <img src={commune.heroImage} alt={`Vue de ${commune.name}`} class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-dark to-dark/80"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/20 text-primary text-sm font-bold mb-6 border border-primary/30">
        <span class="w-2 h-2 rounded-full bg-primary animate-pulse"></span> Intervention Rapide
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Plombier Chauffagiste à <span class="text-primary">{commune.name}</span></h1>
      <p class="text-xl text-gray-300 max-w-2xl mb-8">Vous cherchez un artisan fiable sur {commune.name} ({commune.postalCode}) ? Nous sommes situés à seulement {commune.distanceFromTournai} et pouvons intervenir chez vous en {commune.interventionTime} en cas d'urgence.</p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="tel:+32000000000" class="bg-primary hover:bg-primary-hover text-white px-8 py-4 rounded-lg font-bold text-lg text-center transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Appeler le +32 000 00 00 00
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Nos Services à Commune -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Nos services à {commune.name}</h2>
          <p class="text-gray-600 mb-6">En tant qu'entreprise locale du Tournaisis, nous proposons l'intégralité de nos services aux résidents de {commune.name} :</p>
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <a href="/services/depannage-urgence" class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow group block">
              <h3 class="font-bold text-dark text-lg group-hover:text-primary transition-colors">Dépannage d'Urgence 24/7</h3>
              <p class="text-gray-600 text-sm mt-1">Fuites d'eau, ruptures de canalisations.</p>
            </a>
            <a href="/services/chauffage-chaudieres" class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow group block">
              <h3 class="font-bold text-dark text-lg group-hover:text-primary transition-colors">Chauffage & Entretien</h3>
              <p class="text-gray-600 text-sm mt-1">Dépannage chaudière et entretien agréé.</p>
            </a>
            <a href="/services/debouchage" class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow group block">
              <h3 class="font-bold text-dark text-lg group-hover:text-primary transition-colors">Débouchage Canalisation</h3>
              <p class="text-gray-600 text-sm mt-1">WC, éviers, et curage haute pression.</p>
            </a>
            <a href="/services/installations-sanitaires" class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow group block">
              <h3 class="font-bold text-dark text-lg group-hover:text-primary transition-colors">Installations Sanitaires</h3>
              <p class="text-gray-600 text-sm mt-1">Rénovation de salle de bain complète.</p>
            </a>
          </div>
        </section>

        <!-- Neighborhoods -->
        <section class="bg-blue-50 p-8 rounded-2xl border border-blue-100">
          <h2 class="text-2xl font-bold text-dark mb-4">Quartiers couverts à {commune.name}</h2>
          <p class="text-gray-700 mb-6">Nous connaissons parfaitement {commune.name} et ses rues. Nos artisans interviennent quotidiennement dans ces différents secteurs :</p>
          <div class="flex flex-wrap gap-3">
            {commune.neighborhoods.map(neighborhood => (
              <span class="bg-white px-4 py-2 rounded-full border border-blue-200 text-dark font-medium shadow-sm">
                {neighborhood}
              </span>
            ))}
          </div>
        </section>

        <!-- Competitor Comparison -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Pourquoi nous choisir à {commune.name} ?</h2>
          <p class="text-gray-600 mb-6">Face aux grandes plateformes nationales ou aux artisans isolés, voici pourquoi nos clients de {commune.name} nous recommandent :</p>
          
          <div class="overflow-x-auto bg-white rounded-xl shadow-sm border border-gray-200">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-200">
                  <th class="p-4 font-bold text-gray-700">Critère</th>
                  <th class="p-4 font-bold text-primary">Plombier Tournai</th>
                  <th class="p-4 font-bold text-gray-500">Artisans traditionnels / Plateformes</th>
                </tr>
              </thead>
              <tbody>
                {commune.competitorComparison.map(comp => (
                  <tr class="border-b border-gray-100 last:border-0">
                    <td class="p-4 font-medium text-dark">{comp.point}</td>
                    <td class="p-4 text-green-600 font-medium flex items-center gap-2">
                      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                      {comp.us}
                    </td>
                    <td class="p-4 text-red-500/80 flex items-center gap-2">
                      <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                      {comp.others}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-8">
        
        <!-- Local Proximity Box -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-lg sticky top-28">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-blue-100 text-primary rounded-full flex items-center justify-center shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <div>
              <h3 class="font-bold text-dark">Proximité {commune.name}</h3>
              <p class="text-sm text-gray-500">Distance : {commune.distanceFromTournai}</p>
            </div>
          </div>
          
          <div class="mb-6">
            <h4 class="text-sm font-bold text-dark mb-2">Notre itinéraire vers vous :</h4>
            <div class="bg-gray-50 p-4 rounded text-sm text-gray-600 border border-gray-100">
              <p class="mb-2"><span class="font-semibold text-primary">Départ :</span> {commune.directions.from}</p>
              <p>{commune.directions.route}</p>
              <p class="mt-2 font-semibold text-dark">Temps estimé : {commune.interventionTime}</p>
            </div>
          </div>
          
          <a href="tel:+32000000000" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-colors mb-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Appeler Maintenant
          </a>
          <a href="/contact" class="w-full bg-white text-dark border border-gray-200 hover:bg-gray-50 font-bold py-3 rounded-lg flex items-center justify-center transition-colors">
            Devis Gratuit
          </a>
        </div>
      </div>

    </div>
  </div>
</Layout>
