---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0">
      <img src={post.data.heroImage || "https://images.unsplash.com/photo-1585704032915-c3400ca199e7?auto=format&fm=webp&fit=crop&w=1920&q=80"} alt={post.data.title} class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-dark to-dark/80"></div>
    </div>
    
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
      <div class="text-primary font-medium mb-4">
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('fr-BE', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold font-outfit mb-6 leading-tight">{post.data.title}</h1>
      <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
        {post.data.description}
      </p>
    </div>
  </div>

  <!-- Content Section -->
  <section class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="prose prose-lg prose-blue max-w-none prose-headings:font-outfit prose-headings:font-bold prose-h2:text-3xl prose-h2:mb-4 prose-h2:mt-12 prose-h3:text-2xl prose-a:text-primary hover:prose-a:text-primary-hover prose-img:rounded-xl prose-img:shadow-md">
        <Content />
      </div>

      <!-- CTA Box -->
      <div class="mt-16 bg-blue-50 rounded-2xl p-8 border border-blue-100 text-center">
        <h3 class="text-2xl font-bold font-outfit text-dark mb-4">Besoin d'un dépannage rapide à Tournai ?</h3>
        <p class="text-gray-700 mb-6">Nos plombiers experts sont prêts à intervenir chez vous en moins de 30 minutes.</p>
        <a href="tel:+32000000000" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-hover text-white px-8 py-3 rounded-full font-semibold transition-all transform hover:scale-105 shadow-lg shadow-primary/30">
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Appeler Urgence 24/7
        </a>
      </div>
    </div>
  </section>
</Layout>
