---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Blog Plomberie & Chauffage | Conseils et Actualités à Tournai";
const description = "Retrouvez tous nos conseils d'experts en plomberie, chauffage et débouchage à Tournai. Astuces, guides pratiques et solutions aux problèmes fréquents.";
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0">
      <img src="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?auto=format&fm=webp&fit=crop&w=1920&q=80" alt="Plombier Tournai Blog" class="w-full h-full object-cover opacity-20" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-dark to-dark/80"></div>
    </div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold font-outfit mb-6">Notre Blog <span class="text-primary">Plomberie</span></h1>
      <p class="text-xl text-gray-300 max-w-2xl leading-relaxed">
        Découvrez nos derniers articles, conseils d'experts et astuces pour entretenir votre plomberie et votre chauffage à Tournai.
      </p>
    </div>
  </div>

  <!-- Blog Posts Grid -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map(post => (
          <article class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all border border-gray-100 overflow-hidden flex flex-col">
            <a href={`/blog/${post.id}`} class="block h-48 overflow-hidden">
              <img 
                src={post.data.heroImage || "https://images.unsplash.com/photo-1585704032915-c3400ca199e7?auto=format&fm=webp&fit=crop&w=600&q=80"} 
                alt={post.data.title} 
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" 
                loading="lazy"
              />
            </a>
            <div class="p-6 flex-1 flex flex-col">
              <div class="text-sm text-primary font-medium mb-3">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('fr-BE', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-xl font-bold font-outfit text-dark mb-3 line-clamp-2 hover:text-primary transition-colors">
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
              </h2>
              <p class="text-gray-600 mb-4 line-clamp-3 flex-1 text-sm">
                {post.data.description}
              </p>
              <a href={`/blog/${post.id}`} class="inline-flex items-center text-primary font-semibold hover:text-primary-hover transition-colors">
                Lire l'article
                <svg class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
