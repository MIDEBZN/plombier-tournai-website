---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  { q: "Prenez-vous en charge la totalité de la rénovation de salle de bain ?", a: "Oui, nous gérons votre projet de A à Z : démolition, plomberie, chauffage, pose des sanitaires, et nous travaillons avec des partenaires de confiance pour le carrelage et l'électricité." },
  { q: "Quelles marques de sanitaires installez-vous ?", a: "Nous privilégions les marques reconnues pour leur fiabilité et leur durabilité, telles que Grohe, Hansgrohe, Geberit, Villeroy & Boch, et Facq." },
  { q: "Remplacez-vous les baignoires par des douches à l'italienne ?", a: "C'est l'une de nos demandes les plus fréquentes ! Nous transformons votre ancienne baignoire en une douche à l'italienne moderne, accessible et sécurisée, souvent en quelques jours seulement." },
  { q: "Pouvez-vous réparer un WC suspendu qui fuit ?", a: "Absolument. La réparation d'un WC suspendu (type Geberit) demande une expertise spécifique pour intervenir via la plaque de commande sans casser le mur. C'est l'une de nos spécialités." }
];
---

<Layout title="Installation Sanitaire & Rénovation Salle de Bain Tournai" description="Plombier spécialiste en installation sanitaire à Tournai : rénovation de salle de bain, douche à l'italienne, WC suspendu, robinetterie. Devis gratuit.">
  
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1620626011761-996317b8d101?auto=format&fit=crop&w=1920&q=80')] bg-cover bg-center opacity-20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Installations <span class="text-blue-400">Sanitaires</span></h1>
      <p class="text-xl text-gray-300 max-w-2xl mb-8">De la réparation d'une robinetterie fuyarde à la création complète de votre nouvelle salle de bain. Un travail soigné, esthétique et durable à Tournai.</p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/contact" class="bg-blue-500 hover:bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg text-center transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/30">
          Demander un devis (Gratuit)
        </a>
        <a href="tel:+32000000000" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 py-4 rounded-lg font-bold text-lg text-center transition-all backdrop-blur-sm">
          Urgence Fuite: +32 000 00 00 00
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Services Grid -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Nos Domaines d'Intervention</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Salle de Bain Complète</h3>
                <p class="text-gray-600 text-sm mt-1">Rénovation complète ou création de salle de bain (douche à l'italienne, baignoire îlot, meubles vasques).</p>
              </div>
            </div>
            
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">WC Suspendus & Standards</h3>
                <p class="text-gray-600 text-sm mt-1">Installation de toilettes modernes (Geberit), réparation de chasse d'eau et remplacement de cuvettes.</p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Robinetterie</h3>
                <p class="text-gray-600 text-sm mt-1">Remplacement de mitigeurs, mélangeurs, colonnes de douche et robinets thermostatiques.</p>
              </div>
            </div>

            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Tuyauterie & Raccordements</h3>
                <p class="text-gray-600 text-sm mt-1">Modification de tuyauterie (Alpex, Cuivre, PER), création de nouvelles arrivées d'eau ou évacuations.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- What's Included -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Un service clé en main</h2>
          <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
            <p class="text-gray-600 mb-4">Pour une rénovation de salle de bain, nous vous accompagnons à chaque étape :</p>
            <ul class="space-y-3">
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                <span><strong>Conseil & Conception :</strong> Aide au choix des matériaux, étude de faisabilité technique selon vos évacuations actuelles.</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                <span><strong>Démolition & Évacuation :</strong> Nous démontons l'ancienne installation et évacuons les gravats proprement.</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                <span><strong>Installation :</strong> Travail réalisé dans les règles de l'art, avec une étanchéité parfaite (systèmes Kerdi/Schlüter pour les douches).</span>
              </li>
              <li class="flex items-start gap-3 text-sm text-gray-700">
                <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 
                <span><strong>Garantie :</strong> Tous nos travaux de plomberie sont couverts par notre garantie décennale.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- FAQs -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Questions Fréquentes (FAQ)</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark text-lg mb-2">{faq.q}</h3>
                <p class="text-gray-600">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-8">
        
        <!-- Premium Box -->
        <div class="bg-gradient-to-br from-gray-900 to-gray-800 p-6 rounded-xl shadow-lg sticky top-28">
          <h3 class="text-xl font-bold text-white mb-2">Projet Rénovation ?</h3>
          <p class="text-gray-300 text-sm mb-6">Faites de votre salle de bain un espace de détente unique. Devis gratuit et personnalisé.</p>
          
          <ul class="space-y-3 mb-6 text-sm">
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-200 font-medium">Devis Détaillé 100% Gratuit</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-200 font-medium">Grand choix de marques (Grohe, Facq...)</span>
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-gray-200 font-medium">Garantie sur les travaux</span>
            </li>
          </ul>
          
          <a href="/contact" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-colors mb-3">
            Parlez-nous de votre projet
          </a>
        </div>

        <!-- Service Area -->
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <h3 class="text-lg font-bold text-dark mb-4">Secteur couvert</h3>
          <div class="flex flex-wrap gap-2">
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Tournai</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Mouscron</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Ath</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Péruwelz</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Leuze-en-Hainaut</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</Layout>
