---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  { q: "Qu'est-ce que l'hydrocurage ?", a: "L'hydrocurage est une technique de débouchage qui utilise un jet d'eau à très haute pression. Cela permet de pulvériser les bouchons tenaces (graisse, tartre, racines) et de nettoyer entièrement les parois de vos canalisations." },
  { q: "Intervenez-vous pour des petits bouchons (évier, baignoire) ?", a: "Absolument. Nous traitons tous les types d'engorgements, du simple siphon d'évier bouché aux canalisations principales et égouts extérieurs." },
  { q: "Combien de temps prend un débouchage ?", a: "Pour un débouchage classique (WC, évier), l'intervention dure généralement moins d'une heure. Pour un curage complet ou une inspection par caméra, prévoyez entre 1 et 2 heures." },
  { q: "Faites-vous la vidange de fosse septique ?", a: "Oui, nous sommes équipés d'un camion pompe pour réaliser la vidange et le nettoyage complet de votre fosse septique ou fosse toutes eaux dans la région de Tournai." }
];
---

<Layout title="Débouchage Canalisation et Égout Tournai | Hydrocurage" description="Débouchage d'urgence à Tournai : WC, éviers, canalisations et égouts. Inspection caméra, hydrocurage haute pression et vidange de fosse septique.">
  
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-blue-900/20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Débouchage Canalisation & Égouts</h1>
      <p class="text-xl text-gray-300 max-w-2xl mb-8">Des WC bouchés ou des égouts qui refoulent ? Nous disposons de matériel professionnel (hydrocurage, caméra) pour résoudre définitivement vos problèmes d'obstruction à Tournai.</p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="tel:+32000000000" class="bg-primary hover:bg-primary-hover text-white px-8 py-4 rounded-lg font-bold text-lg text-center transition-all flex items-center justify-center gap-2 shadow-lg shadow-primary/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Urgence Débouchage : +32 000 00 00 00
        </a>
        <a href="/contact" class="bg-white/10 hover:bg-white/20 text-white border border-white/20 px-8 py-4 rounded-lg font-bold text-lg text-center transition-all backdrop-blur-sm">
          Demander un devis
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Common Problems -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Les Engorgements Que Nous Traitons</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">WC et Toilettes Bouchés</h3>
                <p class="text-gray-600 text-sm mt-1">Débouchage rapide manuel ou mécanique pour retrouver l'usage de vos sanitaires.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Éviers, Lavabos, Douches</h3>
                <p class="text-gray-600 text-sm mt-1">Élimination des bouchons de graisse, cheveux ou résidus de savon.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Égouts et Canalisations Principales</h3>
                <p class="text-gray-600 text-sm mt-1">Hydrocurage haute pression pour les réseaux extérieurs complètement obstrués.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Problèmes Répétitifs</h3>
                <p class="text-gray-600 text-sm mt-1">Inspection par caméra pour identifier les cassures ou défauts de pente.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- What's Included -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Nos Prestations Détaillées</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Débouchage manuel et mécanique :</strong> Utilisation de furets professionnels, pompes à vide, et déboucheurs électriques pour les bouchons domestiques.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Curage haute pression :</strong> Nettoyage en profondeur des parois des canalisations à l'aide d'un véhicule d'hydrocurage adapté.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Inspection par caméra endoscopique :</strong> Visualisation de l'intérieur des tuyaux avec enregistrement vidéo pour détecter fissures, racines, ou affaissements.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span><strong>Vidange de fosse septique :</strong> Pompage, vidange et nettoyage de fosses septiques, bacs à graisses et micro-stations d'épuration.</span>
            </li>
          </ul>
        </section>

        <!-- Our Process -->
        <section class="bg-gray-50 p-8 rounded-2xl border border-gray-100">
          <h2 class="text-3xl font-bold text-dark mb-8">Comment se déroule un débouchage ?</h2>
          <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-300 before:to-transparent">
            
            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">1</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Diagnostic</h3>
                <p class="text-sm text-gray-600 mt-1">Analyse de la situation pour déterminer la localisation du bouchon et la méthode la plus adaptée.</p>
              </div>
            </div>
            
            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">2</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Action ciblée</h3>
                <p class="text-sm text-gray-600 mt-1">Utilisation de la méthode choisie (furet, pompe, ou hydrocurage haute pression).</p>
              </div>
            </div>

            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">3</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Vérification (Optionnel)</h3>
                <p class="text-sm text-gray-600 mt-1">Si le problème est récurrent, passage de la caméra pour s'assurer que le réseau est sain.</p>
              </div>
            </div>

            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">4</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Nettoyage & Conseils</h3>
                <p class="text-sm text-gray-600 mt-1">Nous laissons les lieux propres et vous conseillons pour éviter que cela ne se reproduise.</p>
              </div>
            </div>

          </div>
        </section>

        <!-- FAQs -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Questions Fréquentes (FAQ)</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark text-lg mb-2">{faq.q}</h3>
                <p class="text-gray-600">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-8">
        
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100 shadow-sm sticky top-28">
          <h3 class="text-xl font-bold text-dark mb-4">Intervention Débouchage</h3>
          <ul class="space-y-3 mb-6 text-sm">
            <li class="flex justify-between border-b border-blue-200 pb-2">
              <span class="text-gray-700">Débouchage WC</span>
              <span class="font-bold text-primary">Intervention 7j/7</span>
            </li>
            <li class="flex justify-between border-b border-blue-200 pb-2">
              <span class="text-gray-700">Hydrocurage</span>
              <span class="font-bold text-primary">Sur RDV ou Urgence</span>
            </li>
            <li class="flex justify-between border-b border-blue-200 pb-2">
              <span class="text-gray-700">Inspection Caméra</span>
              <span class="font-bold text-primary">Disponible</span>
            </li>
            <li class="flex justify-between pb-2">
              <span class="text-gray-700">Vidange Fosse Septique</span>
              <span class="font-bold text-primary">Sur RDV</span>
            </li>
          </ul>
          
          <h4 class="font-bold text-dark mb-2 text-sm">Nous couvrons :</h4>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Tournai</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Mouscron</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Ath</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Péruwelz</span>
            <span class="bg-white border border-blue-200 text-gray-700 text-xs px-2 py-1 rounded">Leuze-en-Hainaut</span>
          </div>

          <a href="/contact" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-colors mb-3">
            Obtenir un devis gratuit
          </a>
          <a href="tel:+32000000000" class="w-full bg-white text-primary border border-primary hover:bg-blue-50 font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Appel Urgence
          </a>
        </div>

        <!-- Why Choose Us -->
        <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
          <h3 class="text-lg font-bold text-dark mb-4">Pourquoi nous choisir ?</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Matériel professionnel dernière génération (hydrocureuse, caméra)</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Pas de produits chimiques toxiques, respect de l'environnement</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-secondary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Résultat garanti sur le long terme</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</Layout>
