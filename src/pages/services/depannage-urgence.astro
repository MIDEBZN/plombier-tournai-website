---
import Layout from '../../layouts/Layout.astro';

const faqs = [
  { q: "En combien de temps pouvez-vous intervenir ?", a: "Pour toute urgence à Tournai, nous garantissons une intervention dans les 30 minutes suivant votre appel, 24h/24 et 7j/7." },
  { q: "Quels sont vos tarifs pour un dépannage urgent le week-end ?", a: "Nos tarifs sont transparents. Un devis clair vous est communiqué par téléphone ou avant toute intervention. Une majoration standard s'applique les week-ends et jours fériés, mais sans surprise." },
  { q: "Que dois-je faire en attendant votre arrivée lors d'une fuite ?", a: "Coupez immédiatement l'arrivée d'eau principale de votre logement (généralement située près du compteur) pour limiter les dégâts des eaux, et éloignez les appareils électriques de la zone inondée." }
];
---

<Layout title="Dépannage Plomberie Urgence 24/7 Tournai" description="Urgence plomberie à Tournai ! Intervention en 30 minutes 24h/24 et 7j/7 pour fuites d'eau, canalisations bouchées et pannes de chaudière.">
  
  <!-- Hero Section -->
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-red-900/20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 text-red-400 text-sm font-bold mb-6 border border-red-500/30">
        <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> Service 24/7
      </div>
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6">Dépannage d'Urgence Plomberie & Chauffage</h1>
      <p class="text-xl text-gray-300 max-w-2xl mb-8">Une fuite d'eau majeure ou une panne de chaudière en plein hiver ? Nos artisans plombiers interviennent à Tournai et ses alentours en moins de 30 minutes.</p>
      
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="tel:+32000000000" class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-lg font-bold text-lg text-center transition-all flex items-center justify-center gap-2 shadow-lg shadow-red-600/30">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Appeler le +32 000 00 00 00
        </a>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-12">
        
        <!-- Common Problems -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Problèmes Fréquents Que Nous Résolvons</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-red-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Rupture de canalisation</h3>
                <p class="text-gray-600 text-sm mt-1">Dégâts des eaux imminents nécessitant une coupure et réparation immédiate.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-orange-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14v6m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Panne de chauffage totale</h3>
                <p class="text-gray-600 text-sm mt-1">Chaudière à l'arrêt en période de froid, nécessitant un diagnostic urgent.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-blue-500 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Fuite de gaz suspectée</h3>
                <p class="text-gray-600 text-sm mt-1">Urgence absolue. Mise en sécurité et détection immédiate de la fuite.</p>
              </div>
            </div>
            <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm flex items-start gap-4">
              <div class="text-gray-700 mt-1">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </div>
              <div>
                <h3 class="font-bold text-dark text-lg">Engorgement sévère</h3>
                <p class="text-gray-600 text-sm mt-1">Refoulement des eaux usées nécessitant un hydrocurage express.</p>
              </div>
            </div>
          </div>
        </section>

        <!-- What's Included -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Ce Qui Est Inclus Dans l'Intervention</h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Déplacement rapide sur les lieux (moins de 30 min sur Tournai).</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Diagnostic précis et recherche de l'origine exacte du problème.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Mise en sécurité immédiate de l'installation (coupure d'eau/gaz, colmatage provisoire).</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Établissement d'un devis clair avant toute réparation définitive.</span>
            </li>
            <li class="flex items-start gap-3 text-gray-700">
              <svg class="w-6 h-6 text-secondary shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>Réparation avec des pièces de rechange certifiées (stock dans nos véhicules).</span>
            </li>
          </ul>
        </section>

        <!-- Our Process -->
        <section class="bg-gray-50 p-8 rounded-2xl border border-gray-100">
          <h2 class="text-3xl font-bold text-dark mb-8">Notre Processus d'Intervention</h2>
          <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-gray-300 before:to-transparent">
            
            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">1</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">L'Appel</h3>
                <p class="text-sm text-gray-600 mt-1">Vous nous contactez. Nous évaluons la gravité et vous donnons les premières consignes de sécurité.</p>
              </div>
            </div>
            
            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">2</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Déplacement en 30 min</h3>
                <p class="text-sm text-gray-600 mt-1">Un technicien part immédiatement avec un véhicule entièrement équipé pour votre secteur.</p>
              </div>
            </div>

            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">3</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Sécurisation & Devis</h3>
                <p class="text-sm text-gray-600 mt-1">Mise en sécurité de l'installation et proposition d'un devis ferme avant réparation.</p>
              </div>
            </div>

            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
              <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white bg-primary text-white shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 font-bold z-10">4</div>
              <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] bg-white p-4 rounded border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark">Réparation</h3>
                <p class="text-sm text-gray-600 mt-1">Validation du devis et réparation immédiate pour un retour à la normale.</p>
              </div>
            </div>

          </div>
        </section>

        <!-- FAQs -->
        <section>
          <h2 class="text-3xl font-bold text-dark mb-6">Questions Fréquentes (FAQ)</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <div class="bg-white p-6 rounded-xl border border-gray-100 shadow-sm">
                <h3 class="font-bold text-dark text-lg mb-2">{faq.q}</h3>
                <p class="text-gray-600">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>

      </div>

      <!-- Sidebar -->
      <div class="lg:col-span-1 space-y-8">
        <!-- Emergency Box -->
        <div class="bg-white p-6 rounded-xl border-t-4 border-red-500 shadow-lg sticky top-28">
          <h3 class="text-xl font-bold text-dark mb-4">Disponibilité Urgence</h3>
          <ul class="space-y-3 mb-6">
            <li class="flex justify-between border-b border-gray-100 pb-2">
              <span class="text-gray-600">Lundi - Vendredi</span>
              <span class="font-bold text-red-500">24h/24</span>
            </li>
            <li class="flex justify-between border-b border-gray-100 pb-2">
              <span class="text-gray-600">Samedi - Dimanche</span>
              <span class="font-bold text-red-500">24h/24</span>
            </li>
            <li class="flex justify-between pb-2">
              <span class="text-gray-600">Jours fériés</span>
              <span class="font-bold text-red-500">24h/24</span>
            </li>
          </ul>
          
          <h4 class="font-bold text-dark mb-2">Zone d'intervention express (30 min) :</h4>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">Tournai Centre</span>
            <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">Kain</span>
            <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">Froyennes</span>
            <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">Orcq</span>
            <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">Marquain</span>
          </div>

          <a href="tel:+32000000000" class="w-full bg-red-500 hover:bg-red-600 text-white font-bold py-3 rounded-lg flex items-center justify-center gap-2 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Appeler Maintenant
          </a>
        </div>

        <!-- Why Choose Us -->
        <div class="bg-blue-50 p-6 rounded-xl border border-blue-100">
          <h3 class="text-lg font-bold text-dark mb-4">Pourquoi nous choisir ?</h3>
          <ul class="space-y-3">
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Artisans certifiés et expérimentés</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Stock de pièces d'urgence dans les véhicules</span>
            </li>
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span class="text-sm text-gray-700">Assurance responsabilité civile professionnelle</span>
            </li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</Layout>
