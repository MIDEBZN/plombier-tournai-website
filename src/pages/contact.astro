---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact & Devis Gratuit | Plombier Tournai" description="Contactez Plombier Tournai pour une urgence ou un devis gratuit. Disponible 24h/24 et 7j/7 au +32 000 00 00 00.">
  <div class="bg-dark py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-extrabold text-white mb-4 text-center">Contactez-nous</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto text-center">Une urgence ou un projet de rénovation ? Notre équipe est à votre écoute.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Contact Info -->
      <div class="w-full lg:w-1/3 space-y-8">
        <!-- Emergency Alert -->
        <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-xl">
          <div class="flex items-center gap-3 mb-2">
            <svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <h3 class="font-bold text-red-700 text-lg">Urgence ?</h3>
          </div>
          <p class="text-red-600 font-medium mb-4">N'utilisez pas ce formulaire pour une urgence ! Appelez-nous directement.</p>
          <a href="tel:+32000000000" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg font-bold block text-center transition-colors">
            Appeler le +32 000 00 00 00
          </a>
        </div>

        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
          <h3 class="font-bold text-xl text-dark mb-6">Coordonnées</h3>
          <ul class="space-y-6">
            <li class="flex items-start gap-4">
              <div class="bg-blue-50 p-3 rounded-full text-primary shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 font-medium">Téléphone</p>
                <a href="tel:+32000000000" class="text-dark font-bold hover:text-primary transition-colors">+32 000 00 00 00</a>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="bg-blue-50 p-3 rounded-full text-primary shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 font-medium">Email</p>
                <a href="mailto:contact@plombier-tournai.be" class="text-dark font-bold hover:text-primary transition-colors">contact@plombier-tournai.be</a>
              </div>
            </li>
            <li class="flex items-start gap-4">
              <div class="bg-blue-50 p-3 rounded-full text-primary shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 font-medium">Secteur</p>
                <p class="text-dark font-bold">Tournai et 30km aux alentours</p>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="w-full lg:w-2/3 bg-white p-8 rounded-2xl shadow-lg border border-gray-100">
        <h2 class="text-2xl font-bold text-dark mb-6">Demander un devis gratuit</h2>
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Formulaire envoyé ! (Démo)');">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nom complet *</label>
              <input type="text" id="name" name="name" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow" placeholder="Jean Dupont" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Téléphone *</label>
              <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow" placeholder="0470 00 00 00" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="email" name="email" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow" placeholder="jean@example.com" />
          </div>
          <div>
            <label for="service" class="block text-sm font-medium text-gray-700 mb-1">Service concerné</label>
            <select id="service" name="service" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow bg-white">
              <option value="plomberie">Dépannage Plomberie</option>
              <option value="chauffage">Chauffage & Chaudière</option>
              <option value="debouchage">Débouchage</option>
              <option value="fuite">Recherche de fuite</option>
              <option value="autre">Autre demande</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Description de votre problème *</label>
            <textarea id="message" name="message" rows="4" required class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-shadow resize-none" placeholder="Décrivez votre situation..."></textarea>
          </div>
          <button type="submit" class="w-full bg-primary hover:bg-primary-hover text-white font-bold py-4 rounded-lg transition-colors flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
            Envoyer ma demande
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
