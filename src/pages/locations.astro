---
import Layout from '../layouts/Layout.astro';
import { communes } from '../data/communes';

const otherCommunes = [
  'Ramegnies-Chin', 'Gaurain-Ramecroix', 'Templeuve', 'Blandain', 'Hertain', 'Lamain', 'Marquain'
];
---

<Layout title="Nos zones d'intervention | Plombier Tournai et environs" description="Découvrez nos zones d'intervention. Plombier chauffagiste intervenant rapidement à Tournai, Mouscron, Ath, Péruwelz, Kain, Froyennes et Orcq.">
  <div class="bg-dark text-white pt-24 pb-16 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Zones d'Intervention</h1>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Basés à Tournai, nous intervenons rapidement dans toute la région du Tournaisis et ses communes limitrophes.
      </p>
    </div>
  </div>

  <div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <h2 class="text-2xl font-bold text-dark mb-8">Nos agences et secteurs prioritaires</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {communes.map(commune => (
          <a href={`/locations/${commune.slug}`} class="bg-white rounded-xl shadow-sm hover:shadow-xl border border-gray-100 transition-all group block overflow-hidden">
            <div class="h-32 w-full relative">
              <img src={commune.heroImage} alt={commune.name} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-dark/40 group-hover:bg-dark/20 transition-colors"></div>
              <div class="absolute bottom-4 left-4 text-white font-bold text-xl drop-shadow-md">
                Plombier {commune.name}
              </div>
            </div>
            <div class="p-6">
              <div class="flex items-center gap-2 text-sm text-gray-600 mb-2">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Intervention en {commune.interventionTime}
              </div>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">Dépannage plomberie et urgence chauffage sur {commune.name} et ses quartiers (Code postal: {commune.postalCode}).</p>
              <div class="text-primary font-medium text-sm group-hover:translate-x-1 transition-transform inline-block">
                Voir les détails du secteur &rarr;
              </div>
            </div>
          </a>
        ))}
      </div>
      
      <!-- Other communes -->
      <h2 class="text-2xl font-bold text-dark mb-6">Également à votre service à...</h2>
      <div class="flex flex-wrap gap-3 mb-16">
        {otherCommunes.map(c => (
          <span class="bg-white px-4 py-2 rounded-full border border-gray-200 text-gray-700 font-medium shadow-sm">
            {c}
          </span>
        ))}
      </div>

      <!-- General Catch-all -->
      <div class="bg-blue-50 rounded-2xl p-8 lg:p-12 text-center border border-blue-100 flex flex-col items-center">
        <h3 class="text-2xl font-bold text-dark mb-4">Votre commune n'est pas listée ?</h3>
        <p class="text-gray-700 max-w-2xl mb-8">Nous couvrons un large secteur ! Si vous habitez dans un rayon de 30 km autour de Tournai (Hainaut occidental), nous pouvons intervenir chez vous.</p>
        <a href="tel:+32000000000" class="bg-primary hover:bg-primary-hover text-white px-8 py-4 rounded-lg font-bold transition-colors inline-flex items-center gap-2 shadow-lg shadow-primary/30">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Contactez-nous pour vérifier
        </a>
      </div>
    </div>
  </div>
</Layout>
