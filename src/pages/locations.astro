---
import Layout from '../layouts/Layout.astro';

// In a real app, this could be a dynamic collection, but for now we list the communes.
const communes = [
  { name: 'Kain', desc: 'Intervention plomberie et chauffage à Kain en moins de 30 min.' },
  { name: 'Froyennes', desc: 'Dépannage chaudière et débouchage rapide sur Froyennes.' },
  { name: 'Orcq', desc: 'Votre artisan plombier pour toutes urgences à Orcq.' },
  { name: 'Marquain', desc: 'Débouchage haute pression et recherche de fuite à Marquain.' },
  { name: 'Ramegnies-Chin', desc: 'Installation sanitaire et entretien chaudière.' },
  { name: 'Gaurain-Ramecroix', desc: 'Chauffagiste agréé intervenant à Gaurain-Ramecroix.' },
  { name: 'Templeuve', desc: 'Plombier urgence 24/7 disponible sur Templeuve.' },
  { name: 'Blandain', desc: 'Intervention rapide pour fuites et pannes à Blandain.' },
];
---

<Layout title="Nos zones d'intervention autour de Tournai" description="Plombier chauffagiste intervenant à Tournai, Kain, Froyennes, Orcq et toutes les communes voisines.">
  <div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-4xl font-extrabold text-dark mb-4">Zones d'Intervention</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Basés à Tournai, nous intervenons rapidement dans toute la région. Découvrez nos services près de chez vous.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {communes.map(commune => (
          <div class="bg-white p-6 rounded-xl shadow-sm hover:shadow-md border border-gray-100 transition-all">
            <div class="flex items-center gap-3 mb-3">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              <h2 class="text-xl font-bold text-dark">Plombier {commune.name}</h2>
            </div>
            <p class="text-gray-600 text-sm">{commune.desc}</p>
            <a href="/contact" class="mt-4 inline-block text-primary font-medium text-sm hover:underline">Demander une intervention &rarr;</a>
          </div>
        ))}
      </div>
      
      <!-- General Catch-all -->
      <div class="mt-16 bg-blue-50 rounded-2xl p-8 text-center border border-blue-100">
        <h3 class="text-2xl font-bold text-dark mb-2">Votre commune n'est pas listée ?</h3>
        <p class="text-gray-600 mb-6">Nous intervenons dans un rayon de 30 km autour de Tournai.</p>
        <a href="tel:+32000000000" class="bg-primary hover:bg-primary-hover text-white px-8 py-3 rounded-lg font-bold transition-colors inline-flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Contactez-nous pour vérifier
        </a>
      </div>
    </div>
  </div>
</Layout>
