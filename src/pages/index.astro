---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Plombier Tournai - Dépannage et Urgence 24/7" description="Plombier chauffagiste à Tournai. Dépannage urgent 24/7, installation, entretien et débouchage. Devis gratuit et intervention rapide.">
  <!-- Hero Section -->
  <section class="relative bg-light-bg overflow-hidden">
    <!-- Decorative Shape -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-primary/10 blur-3xl"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-secondary/10 blur-3xl"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex flex-col lg:flex-row items-center py-16 lg:py-24 gap-12">
        <!-- Text Content -->
        <div class="w-full lg:w-1/2 space-y-8">
          <div class="inline-block px-4 py-2 bg-blue-50 border border-blue-100 rounded-full text-primary font-medium text-sm tracking-wide">
            🏆 Plombier N°1 à Tournai & Environs
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-dark leading-tight">
            Intervention Rapide <br>
            <span class="text-primary">Plomberie & Chauffage</span>
          </h1>
          <p class="text-lg text-gray-600 leading-relaxed max-w-xl">
            Ne laissez pas une fuite ou une panne gâcher votre journée. Nos experts interviennent en urgence 24h/24 et 7j/7 avec un travail garanti et des tarifs transparents.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="tel:+32000000000" class="bg-primary hover:bg-primary-hover text-white px-8 py-4 rounded-lg font-bold text-lg text-center transition-all transform hover:scale-105 shadow-xl shadow-primary/30 flex items-center justify-center gap-2">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              Appeler Maintenant
            </a>
            <a href="/contact" class="bg-white hover:bg-gray-50 text-dark border border-gray-200 px-8 py-4 rounded-lg font-bold text-lg text-center transition-all">
              Demander un Devis
            </a>
          </div>
          <!-- Trust Indicators -->
          <div class="flex items-center gap-6 pt-4">
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-sm font-medium text-gray-700">Agréé CERGA</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <span class="text-sm font-medium text-gray-700">Sur place en 30 min</span>
            </div>
          </div>
        </div>
        
        <!-- Image Content -->
        <div class="w-full lg:w-1/2 relative">
          <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[4/3] bg-gray-200">
             <!-- Placeholder for Hero Image -->
             <img src="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?q=80&w=1000&auto=format&fit=crop" alt="Plombier professionnel au travail" class="w-full h-full object-cover" />
          </div>
          <!-- Floating Badge -->
          <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-xl border border-gray-100 flex items-center gap-4 animate-bounce" style="animation-duration: 3s;">
            <div class="bg-secondary p-3 rounded-full">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"></path></svg>
            </div>
            <div>
              <p class="text-xs text-gray-500 uppercase font-semibold">Clients Satisfaits</p>
              <p class="text-xl font-bold text-dark">98% ★★★★★</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Features Section (Based on design inspiration) -->
  <section class="py-16 bg-white relative z-20 -mt-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 text-center transition-transform hover:-translate-y-2">
          <div class="w-16 h-16 mx-auto bg-blue-50 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Service d'Urgence</h3>
          <p class="text-gray-600">Intervention dans la demi-heure pour toutes vos urgences plomberie et chauffage à Tournai.</p>
        </div>
        <!-- Feature 2 -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 text-center transition-transform hover:-translate-y-2">
          <div class="w-16 h-16 mx-auto bg-green-50 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Tarifs Transparents</h3>
          <p class="text-gray-600">Pas de mauvaises surprises. Devis clair et détaillé avant chaque intervention.</p>
        </div>
        <!-- Feature 3 -->
        <div class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 text-center transition-transform hover:-translate-y-2">
          <div class="w-16 h-16 mx-auto bg-blue-50 rounded-full flex items-center justify-center mb-6">
            <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Travail Garanti</h3>
          <p class="text-gray-600">Artisans qualifiés et agréés. Votre satisfaction est notre priorité absolue.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Section -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span class="text-primary font-bold uppercase tracking-wider text-sm">Nos Expertises</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark mt-2">Solutions pour tous vos problèmes</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Service 1 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
          <div class="h-48 bg-gray-200 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1607472586893-edb57cbce4ea?auto=format&fit=crop&w=600&q=80" alt="Dépannage Plomberie" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark mb-2">Dépannage Plomberie</h3>
            <p class="text-gray-600 mb-4 text-sm">Réparation de fuites, remplacement de robinetterie, installation sanitaire.</p>
            <a href="/services#plomberie" class="text-primary font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              En savoir plus <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
          <div class="h-48 bg-gray-200 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&w=600&q=80" alt="Installation Chaudière" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark mb-2">Chauffage & Chaudière</h3>
            <p class="text-gray-600 mb-4 text-sm">Entretien, réparation et installation de chaudières toutes marques.</p>
            <a href="/services#chauffage" class="text-primary font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              En savoir plus <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
          <div class="h-48 bg-gray-200 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1542013936693-884638332954?auto=format&fit=crop&w=600&q=80" alt="Débouchage" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark mb-2">Débouchage</h3>
            <p class="text-gray-600 mb-4 text-sm">Débouchage WC, éviers, égouts. Hydrocurage et inspection caméra.</p>
            <a href="/services#debouchage" class="text-primary font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              En savoir plus <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>

        <!-- Service 4 -->
        <div class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow group">
          <div class="h-48 bg-gray-200 overflow-hidden">
            <img src="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?auto=format&fit=crop&w=600&q=80" alt="Recherche de fuite" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark mb-2">Recherche de Fuite</h3>
            <p class="text-gray-600 mb-4 text-sm">Détection non destructive par caméra thermique et gaz traceur.</p>
            <a href="/services#fuite" class="text-primary font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              En savoir plus <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Bar -->
  <section class="bg-primary py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-white">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold mb-2">Besoin d'un plombier en urgence ?</h2>
          <p class="text-blue-100 text-lg">Nos équipes sont prêtes à intervenir immédiatement.</p>
        </div>
        <a href="tel:+32000000000" class="bg-white text-primary px-8 py-4 rounded-full font-bold text-xl shadow-lg hover:bg-gray-50 transition-colors flex items-center gap-3 whitespace-nowrap">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          +32 000 00 00 00
        </a>
      </div>
    </div>
  </section>
</Layout>
