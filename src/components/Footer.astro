---
const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-white pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Map Section -->
    <div class="mb-12 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 bg-gray-900">
      <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2726.6555305855522!2d3.383383076566471!3d50.60612327162229!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2ffd27aa944e67d1%3A0x53ee279ca1390e40!2sAttica%20Plombier%20Tournai%20Urgent!5e1!3m2!1sen!2sbe!4v1788299626473!5m2!1sen!2sbe" class="w-full h-72 md:h-96" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="space-y-4">
        <a href="/" class="flex items-center">
          <img src="/logo.png" alt="Plombier Tournai Logo" class="h-14 w-auto brightness-0 invert opacity-90" />
        </a>
        <p class="text-gray-400 text-sm leading-relaxed">
          Votre partenaire de confiance pour tous vos travaux de plomberie, chauffage et débouchage à Tournai et ses environs. Intervention rapide garantie.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Liens Rapides</h3>
        <ul class="space-y-2">
          <li><a href="/" class="text-gray-400 hover:text-primary transition-colors text-sm">Accueil</a></li>
          <li><a href="/about" class="text-gray-400 hover:text-primary transition-colors text-sm">À propos de nous</a></li>
          <li><a href="/locations" class="text-gray-400 hover:text-primary transition-colors text-sm">Zones d'intervention</a></li>
          <li><a href="/blog" class="text-gray-400 hover:text-primary transition-colors text-sm">Blog & Conseils</a></li>
          <li><a href="/contact" class="text-gray-400 hover:text-primary transition-colors text-sm">Contactez-nous</a></li>
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Nos Services</h3>
        <ul class="space-y-3">
          <li><a href="/services/depannage-urgence" class="text-gray-400 hover:text-white transition-colors text-sm">Dépannage d'Urgence</a></li>
          <li><a href="/services/debouchage" class="text-gray-400 hover:text-white transition-colors text-sm">Débouchage</a></li>
          <li><a href="/services/detection-fuites" class="text-gray-400 hover:text-white transition-colors text-sm">Détection de Fuites</a></li>
          <li><a href="/services/chauffage-chaudieres" class="text-gray-400 hover:text-white transition-colors text-sm">Chauffage & Chaudières</a></li>
          <li><a href="/services/installations-sanitaires" class="text-gray-400 hover:text-white transition-colors text-sm">Installations Sanitaires</a></li>
          <li><a href="/services/traitement-eau" class="text-gray-400 hover:text-white transition-colors text-sm">Traitement de l'Eau</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Contact</h3>
        <ul class="space-y-3">
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 text-primary shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <a href="https://maps.app.goo.gl/DUPLVfMWhCkwgQnU9" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-primary transition-colors text-sm">Grand'Place 55, 7500 Tournai</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <a href="tel:+32000000000" class="text-gray-400 hover:text-primary transition-colors text-sm">+32 000 00 00 00</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="h-5 w-5 text-primary shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <a href="mailto:contact@urgenceplomberietournai.be" class="text-gray-400 hover:text-primary transition-colors text-sm">contact@urgenceplomberietournai.be</a>
          </li>
        </ul>
      </div>
    </div>
    
    <div class="border-t border-gray-800 pt-8 mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-gray-500 text-sm">
        &copy; {currentYear} Plombier Tournai. Tous droits réservés.
      </p>
      <div class="flex space-x-4">
        <!-- Social placeholders -->
        <a href="#" class="text-gray-500 hover:text-white transition-colors">
          <span class="sr-only">Facebook</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
