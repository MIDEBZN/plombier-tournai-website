---
---
<section class="py-20 bg-gray-50 border-t border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12 items-center">
      <div class="w-full lg:w-1/2">
        <span class="text-primary font-bold uppercase tracking-wider text-sm">Zone d'intervention</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark mt-2 mb-6">Proche de chez vous, partout dans le Tournaisis</h2>
        <p class="text-gray-600 mb-6 text-lg">
          Grâce à notre implantation centrale à Tournai, nous couvrons un rayon de 30 km avec une rapidité d'intervention inégalée.
        </p>
        <ul class="space-y-4 mb-8">
          <li class="flex items-center gap-3 font-medium text-gray-700">
            <div class="w-2 h-2 bg-primary rounded-full"></div> Tournai Centre & Quartiers (< 15 min)
          </li>
          <li class="flex items-center gap-3 font-medium text-gray-700">
            <div class="w-2 h-2 bg-primary rounded-full"></div> Kain, Froyennes, Orcq (< 20 min)
          </li>
          <li class="flex items-center gap-3 font-medium text-gray-700">
            <div class="w-2 h-2 bg-primary rounded-full"></div> Ath, Mouscron, Péruwelz (< 35 min)
          </li>
        </ul>
        <a href="/locations" class="text-primary font-bold hover:underline inline-flex items-center gap-2 transition-colors">
          Voir toutes nos zones d'intervention
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </a>
      </div>
      <div class="w-full lg:w-1/2">
        <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-200 h-[400px] w-full bg-gray-200 relative group">
          <!-- Google Maps Iframe -->
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d80650.95754530006!2d3.310114761005072!3d50.613382717013854!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c327cf46535d51%3A0x40099ab2f4d5b20!2sTournai!5e0!3m2!1sfr!2sbe!4v1700000000000!5m2!1sfr!2sbe" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            class="grayscale group-hover:grayscale-0 transition-all duration-700">
          </iframe>
          <div class="absolute inset-0 bg-primary/10 pointer-events-none group-hover:bg-transparent transition-all duration-700"></div>
        </div>
      </div>
    </div>
  </div>
</section>
