---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustBanner from '../components/TrustBanner.astro';
import GlobalContactForm from '../components/GlobalContactForm.astro';
import FloatingActions from '../components/FloatingActions.astro';

interface Props {
	title: string;
	description: string;
    hideGlobalForm?: boolean;
}

const { title, description, hideGlobalForm = false } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Plombier Tournai</title>
        
        <!-- Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
        
        <style>
            body {
                font-family: 'Inter', sans-serif;
            }
            h1, h2, h3, h4, h5, h6 {
                font-family: 'Outfit', sans-serif;
            }
        </style>
	</head>
	<body class="flex flex-col min-h-screen">
        <Header />
        <TrustBanner />
		<main class="flex-grow">
			<slot />
            {!hideGlobalForm && <GlobalContactForm />}
		</main>
        <FloatingActions />
        <Footer />
	</body>
</html>
